---
import { actions } from "astro:actions";
import { render } from "astro:content";
import Code from "~/components/Code.astro";
import Comments from "~/components/Comments.astro";
import Link from "~/components/Link.astro";
import Pre from "~/components/Pre.astro";
import Base from "~/layouts/Base.astro";
import { formatDate, getParsedAcceptLangs } from "~/lib/utils";

export const prerender = false;

export const components = {
  a: Link,
  pre: Pre,
};

const { id = "" } = Astro.params;
const { data: post, error } = await Astro.callAction(actions.posts.getById, {
  id,
});

if (error) return Astro.redirect("/500");
if (!post) return Astro.redirect("/404");

const { title, summary, created, modified, tags } = post.data;
const { Content } = await render(post);

const [locale, _] = getParsedAcceptLangs(
  Astro.request.headers.get("accept-language"),
)[0] ?? [undefined];

const createdDate = formatDate(created, locale);
const modifiedDate = formatDate(modified, locale);
---
<Base
  title={title}
  description={summary}
>
  <Code as="h1" code={`# ${title}`} lang={"markdown"} />
  <Code as="h2" code={`## ${summary}`} lang={"markdown"} />
  <Code as="h3" code={`### ${tags.join(", ")}`} lang={"markdown"} />
  <Code
    as="h4"
    code={`#### Created: ${createdDate}`}
    lang={"markdown"}
  />
  {createdDate != modifiedDate && <Code
    as="h5"
    code={`##### Modified: ${modifiedDate}`}
    lang={"markdown"}
  />}
  <hr class="m-4" />
  <article
    id="article"
    class="prose max-w-4/5 md:max-w-full text-pretty md:text-balance flex flex-col justify-center items-center text-sm md:text-base mt-8 prose-pre:border prose-pre:border-skin-line prose-pre:border-solid dark:prose-invert"
  >
    <Content components={components} />
  </article>
  <Comments />
</Base>
