---
import { actions } from "astro:actions";
import { render } from "astro:content";
import Code from "~/components/Code.astro";
import Comments from "~/components/Comments.astro";
import Link from "~/components/Link.astro";
import Base from "~/layouts/Base.astro";
import { formatDate, getParsedAcceptLangs } from "~/lib/utils";

export const prerender = false;

export const components = {
  a: Link,
  // TASK(20261012-233624): fix code component mdx auto map for blog
  // code: Code,
};

const { id = "" } = Astro.params;
const { data: post, error } = await Astro.callAction(actions.posts.getById, {
  id,
});

if (error || !post) if (error) return Astro.redirect("/404");

const { title, summary, created, modified, tags } = post.data;
const { Content } = await render(post);

const [locale, _] = getParsedAcceptLangs(
  Astro.request.headers.get("accept-language"),
)[0] ?? [undefined];

const createdDate = formatDate(created, locale);
const modifiedDate = formatDate(modified, locale);
---

<Base
  title={title}
  description={summary}
  class="justify-start"
>
  <Code as="h1" code={`# ${title}`} lang={"markdown"} />
  <Code as="h2" code={`## ${summary}`} lang={"markdown"} />
  <div class="justify-between">
    <div>
      <Code as="h3" code={`### ${tags.join(", ")}`} lang={"markdown"} />
    </div>
    <Code
      as="h4"
      code={`#### Created: ${createdDate}${createdDate != modifiedDate ? ` | Modified: ${modifiedDate}` : ""}`}
      lang={"markdown"}
    />
  </div>
  <hr class="m-4" />
  <article
    id="article"
    role="article"
    class="prose mx-auto mt-8 max-w-3xl prose-pre:border prose-pre:border-skin-line prose-pre:border-solid prose-invert"
  >
    <Content components={components} />
  </article>
  <Comments />
</Base>
