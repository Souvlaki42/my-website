---
import ActivityCalendar from "~/components/ActivityCalendar";
import Code from "~/components/Code.astro";
import Base from "~/layouts/Base.astro";

const TECHNOLOGIES = {
  Node: "https://nodejs.org/en",
  React: "https://react.dev",
  "Next.js": "https://nextjs.org",
  Typescript: "https://www.typescriptlang.org",
  Databases: undefined,
  Python: "https://www.python.org",
  Astro: "https://astro.build",
  Rust: "https://rust-lang.org",
  Go: "https://go.dev",
  C: "https://www.c-language.org",
  "C++": undefined,
  Java: "https://www.java.com",
  Odin: "https://odin-lang.org",
  Docker: "https://www.docker.com",
  Zsh: "https://www.zsh.org",
  Linux: undefined,
  KDE: "https://kde.org",
};

const technologiesStr =
  "console.log(`" +
  `Technologies I like and use:\n${Object.entries(TECHNOLOGIES)
    .map(([tech, site]) => {
      if (!site) return tech;
      else return `[${tech}](${site})`;
    })
    .join(", ")}` +
  "`);";
---

{/* TASK(20260917-091543): fix layout shift */}
<Base class="space-y-4">
  <Code
    code={`fmt.Println("👋 Hello, World!")`}
    lang={"go"}
    class={"text-2xl font-extrabold"}
  />
  <Code code={`print("I'm Ilias.")`} lang={"python"} class={"text-xl"} />
  <Code code={`System.out.println("I am from 🇬🇷 Greece.");`} lang={"java"} />
  <Code
    code={`fmt.println("I am obsessed with building cool stuff and solving real problems using computers.")`}
    lang={"odin"}
  />
  <Code
    code={`println!("I also love ethical hacking, indie games, swimming, animals and board games.");`}
    lang={"rust"}
  />
  <Code
    code={`std::cout << "I'm currently studying Computer Engineering at University of West Attica, 🏛️ Athens." << std::endl;`}
    lang={"c++"}
  />
  <Code code={technologiesStr} lang={"typescript"} />
  <Code
    code={`printf("Don't hesitate to reach out, through my socials or [ilias@moulas.dev](mailto:ilias@moulas.dev)\\n");`}
    lang={"c"}
  />
  <div class="overflow-x-auto w-full lg:overflow-hidden lg:w-auto">
    <ActivityCalendar client:only="react" />
  </div>
</Base>
