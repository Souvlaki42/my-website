---
import { Code as AstroCode } from "astro:components";
import { injectLinksTransformer } from "~/lib/utils";

type Props = Parameters<typeof AstroCode>[number] & {
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span";
};

const { code, lang = "plaintext", wrap = true, theme, as } = Astro.props;

const Element = as ?? Fragment;
---
{
  (
    <Element>
      <AstroCode
        code={code}
        lang={lang}
        wrap={wrap}
        theme={theme}
        transformers={[
          {
            name: "inject-links",
            postprocess: injectLinksTransformer,
          },
        ]}
      />
    </Element>
  )
}
