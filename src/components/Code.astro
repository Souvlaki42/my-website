---
import { Code as AstroCode } from "astro:components";
import { injectLinksTransformer } from "~/lib/utils";

type Props = Parameters<typeof AstroCode>[number] & {
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span";
};

const {
  code,
  lang = "plaintext",
  wrap = true,
  theme = "catppuccin-mocha",
  as,
} = Astro.props;

const Element = as ?? Fragment;
---

<!-- TASK(20261012-234023): add clipboard copy button on code blocks on hover -->
{
  (
    <Element>
      <AstroCode
        code={code}
        lang={lang}
        wrap={wrap}
        theme={theme}
        transformers={[
          {
            name: "inject-links",
            postprocess: injectLinksTransformer,
          },
        ]}
      />
    </Element>
  )
}
